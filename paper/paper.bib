@article{kim_bidirectional_2024,
	title = {Bidirectional relationship between olfaction and Parkinson’s disease},
	volume = {10},
	issn = {2373-8057},
	url = {https://www.nature.com/articles/s41531-024-00838-4},
	doi = {10.1038/s41531-024-00838-4},
	abstract = {Abstract 
             
              Hyposmia (decreased smell function) is a common early symptom of Parkinson’s disease ({PD}). The shared genetic architecture between hyposmia and {PD} is unknown. We leveraged genome-wide association study ({GWAS}) results for self-assessment of ‘ability to smell’ and {PD} diagnosis to determine shared genetic architecture between the two traits. Linkage disequilibrium score ({LDSC}) regression found that the sense of smell negatively correlated at a genome-wide level with {PD}. Local Analysis of [co]Variant Association ({LAVA}) found negative correlations in four genetic loci near 
              {GBA}1 
              , 
              {ANAPC}4 
              , 
              {SNCA} 
              , and 
              {MAPT} 
              , indicating shared genetic liability only within a subset of prominent {PD} risk genes. Using Mendelian randomization, we found evidence for a strong causal relationship between {PD} and liability towards poorer sense of smell, but weaker evidence for the reverse direction. This work highlights the heritability of olfactory function and its relationship with {PD} heritability and provides further insight into the association between {PD} and hyposmia.},
	pages = {232},
	number = {1},
	journaltitle = {npj Parkinson's Disease},
	shortjournal = {npj Parkinsons Dis.},
	author = {Kim, Jonggeol Jeffrey and Bandres-Ciga, Sara and Heilbron, Karl and {23andMe Research Team} and Aslibekyan, Stella and Auton, Adam and Babalola, Elizabeth and Bell, Robert K. and Bielenberg, Jessica and Bowes, Jonathan and Bryc, Katarzyna and Chaudhary, Ninad S. and Coker, Daniella and Das, Sayantan and DelloRusso, Emily and Elson, Sarah L. and Eriksson, Nicholas and Filshtein, Teresa and Fontanillas, Pierre and Freyman, Will and Fuller, Zach and German, Chris and Granka, Julie M. and Hernandez, Alejandro and Hicks, Barry and Hinds, David A. and Jewett, Ethan M. and Jiang, Yunxuan and Kukar, Katelyn and Kwong, Alan and Liang, Yanyu and Lin, Keng-Han and Llamas, Bianca A. and McIntyre, Matthew H. and Micheletti, Steven J. and Moreno, Meghan E. and Nandakumar, Priyanka and Nguyen, Dominique T. and O’Connell, Jared and Petrakovitz, Aaron A. and Poznik, G. David and Reynoso, Alexandra and Saini, Shubham and Schumacher, Morgan and Selcer, Leah and Shastri, Anjali J. and Shelton, Janie F. and Shi, Jingchunzi and Shringarpure, Suyash and Su, Qiaojuan Jane and Tat, Susana A. and Tran, Vinh and Tung, Joyce Y. and Wang, Xin and Wang, Wei and Weldon, Catherine H. and Wilton, Peter and Wong, Corinna D. and Blauwendraat, Cornelis and Noyce, Alastair J.},
